<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Assembly / tool identity -->
    <AssemblyName>chartula</AssemblyName>
    <RootNamespace>Chartula.Cli</RootNamespace>

    <Version>0.1.0-preview.2</Version>

    <!-- Released as one self-contained file per platform, so a user needs no .NET.
         Set here rather than on the publish command line: the single-file analyzer
         brings in Microsoft.NET.ILLink.Tasks, and only a property the project always
         carries keeps that reference in packages.lock.json for a locked restore. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Halves the download (88 to 44 MB) for about 60 ms more at startup, next to
         a run that waits seconds on a model. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No ICU: a slim container image (Debian, Ubuntu, Fedora, Alpine) has none,
         and the runtime ends the process at startup when it is missing. Chartula
         compares, sorts and formats ordinally or with the invariant culture, and
         writes no text in the user's locale, so ICU would change nothing it prints. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Authors>Felix Wahl</Authors>
    <Description>Multi-audience, grounded changelog generator for your repository.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chartula.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chartula.Core\Chartula.Core.csproj" />
    <ProjectReference Include="..\Chartula.Infrastructure\Chartula.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.49.0" />
    <!-- Pinned to the Microsoft.Extensions.AI version Chartula.Core references, so
         the shared abstractions package is not lifted from underneath the domain. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
