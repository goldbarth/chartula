<Project>

  <PropertyGroup>
    <!-- Every restore resolves exactly what packages.lock.json records, so a
         compromised or re-published package version cannot slip into a build
         unnoticed; CI restores with locked mode and fails on any drift. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
